+import asyncio
+
+import pytest
+from open_webui.utils.telemetry.genai.config import GenAIConfig
+from open_webui.utils.telemetry.genai.streaming import wrap_stream
+from open_webui.utils.telemetry.genai.tracer import GenAITracer
