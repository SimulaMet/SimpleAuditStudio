+
+	const i18n = getContext('i18n');
+
+	let modelStats: Array<{ model_id: string; count: number; name?: string }> = [];
+	let loading = true;
+	let orderBy = 'count';
+	let direction: 'asc' | 'desc' = 'desc';
+
