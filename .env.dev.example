# =============================================================================
# SimpleAudit Studio — local development
#
# Copy to `.env` (manage.py loads it automatically), then:
#
#   uv sync --extra dev
#   uv run manage.py setup_local              # first time: + seed data
#   uv run manage.py dev                       # daily
#
# SQLite holds the app data and `dev` starts its own embedded Hatchet queue,
# so no Docker is needed. For production use Docker Compose with `.env.example`.
#
# Only what the dev flow actually reads is uncommented below. Settings the dev
# server does not use are kept as documented examples at the bottom.
# =============================================================================

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=local-dev-key-not-for-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=DEBUG

# --- Bootstrap (read by setup_local / bootstrap_platform) ----------------------
BOOTSTRAP_USERNAME=studio
BOOTSTRAP_EMAIL=admin@example.local
BOOTSTRAP_PASSWORD=localdevpass123
BOOTSTRAP_PROJECT_NAME=Default

# --- Database -----------------------------------------------------------------
# `manage.py dev` is SQLite-first by design (zero setup) and force-enables
# SQLite; Postgres is the Compose/deployment engine (see `.env.example` +
# docker-compose.yml).
SIMPLEAUDIT_LOCAL_SQLITE=1
# Where the SQLite file lives. Relative paths resolve from the repo root;
# absolute paths are used as-is. Unset/commented = `<repo>/dev.sqlite3`.
SIMPLEAUDIT_SQLITE_PATH=dev.sqlite3

# --- Chat (Open WebUI) ----------------------------------------------------------
# On by default in dev; no line needed. To force it off:
#   SIMPLEAUDIT_CHAT=off          (env)
#   manage.py dev --disable-chat  (flag; wins over the env value)

# =============================================================================
# OPTIONAL — commented out because `manage.py dev` does not read these.
# Un-comment only for the stated use case.
# =============================================================================

# Label for the in-process audit worker pool (default: cpu).
# WORKER_POOL=cpu

# Domain DB on a running local Postgres instead of SQLite. Requires
# SIMPLEAUDIT_LOCAL_SQLITE=0 above (dev is SQLite-first and force-enables it)
# plus a Postgres server on these coordinates. Niche — most people stay on
# SQLite. The embedded Hatchet always uses its own bundled Postgres, not
# these. (Also set SIMPLEAUDIT_MODE=dev so `manage.py mode` can resolve —
# without the SQLite flag, mode inference has no unambiguous signal left.)
# POSTGRES_DB=simpleaudit
# POSTGRES_USER=simpleaudit
# POSTGRES_PASSWORD=localdevpass123
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# External Hatchet server — Compose mode only (dev starts an embedded engine).
# HATCHET_SERVER_URL=http://localhost:8888
# HATCHET_GRPC_URL=localhost:7077
# HATCHET_API_KEY=
# HATCHET_TOKEN_FILE=./hatchet-token
# HATCHET_TLS_STRATEGY=none

# Sentry error reporting — add a DSN to enable; commented out = disabled.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# --- SimpleAudit engine ---------------------------------------------------------
# No configuration needed: the engine is a pip dependency pinned in
# pyproject.toml. To develop against an unmerged engine revision, create a
# gitignored simpleaudit-dependency.yaml at the project root containing ONLY:
#     git_ref: <full-40-char-sha>
# That value is recorded as the run's git_commit provenance. Do NOT edit
# pyproject.toml for a dev override.

# --- Model API keys (optional) ---------------------------------------------------
# Keys can be stored on a connection in the Models page. For connections set
# to "Environment variable", add that variable here (read when a run starts),
# e.g.:
# SIMULACHAT_API_KEY=sk-...
